# ============================================================
#  Ghostty Configuration — Transparent + Blur
#  ------------------------------------------------------------
#  Where to put this file:
#    macOS / Linux : ~/.config/ghostty/config
#    Windows       : %APPDATA%\ghostty\config
#
#  After editing, reload with:  ctrl+shift+, (or Ghostty menu > Reload Config)
# ============================================================

# ---------- Transparency & blur ----------
# background-opacity: 0 = fully transparent, 1 = fully opaque
background-opacity = 0.65
# background-blur-radius: blur strength behind the window (macOS,
# and Linux compositors that support it e.g. KWin). 0 disables it.
background-blur-radius = 45
# Dim the opacity of unfocused split panes a bit further
unfocused-split-opacity = 0.6

# ---------- Window ----------
window-decoration = true
window-padding-x = 12
window-padding-y = 10
window-padding-balance = true
window-save-state = always
window-theme = dark
# macOS: give tabs their own titlebar style instead of a bulky bar
macos-titlebar-style = tabs

# ---------- Theme & colors ----------
theme = "Catppuccin Mocha"
cursor-style = block
cursor-style-blink = true
cursor-invert-fg-bg = true

# ---------- Font ----------
# There's no "start zoomed out by N steps" setting in Ghostty — the
# increase/decrease_font_size keybinds below just nudge the size for
# the current session and don't change the baseline. So to make
# "zoomed out twice" the actual default, we bake it into font-size
# directly: 13 (normal) minus two 1pt steps = 11.
font-family = "JetBrains Mono"
font-size = 10
font-thicken = true
adjust-cell-height = 5%

# ---------- Behavior ----------
copy-on-select = true
confirm-close-surface = false
mouse-hide-while-typing = true
shell-integration = detect
shell-integration-features = cursor,sudo,title

# ---------- macOS niceties ----------
macos-option-as-alt = true

# ---------- Keybindings ----------
# macOS copy/paste (cmd+c / cmd+v) — these are Ghostty's default on
# macOS, but set explicitly in case they've been overridden anywhere
keybind = cmd+c=copy_to_clipboard
keybind = cmd+v=paste_from_clipboard
keybind = ctrl+shift+n=new_window
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+equal=increase_font_size:1
keybind = ctrl+shift+minus=decrease_font_size:1
keybind = ctrl+shift+zero=reset_font_size
